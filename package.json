{
	"name": "adacta",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"license": "MIT",
	"repository": "git@github.com:omegadot-software/adacta.git",
	"scripts": {
		"dev": "bun --bun react-router dev",
		"build": "bun --bun react-router build",
		"start": "bun server.ts",
		"db:migrations:refresh": "bun scripts/db.ts refresh",
		"db:migrations:migrate": "bun scripts/db.ts migrate",
		"db:reset": "bun scripts/db.ts reset",
		"db:setup": "bun scripts/db.ts setup",
		"db:seed": "bun scripts/db.ts seed",
		"precommit": "bun install --dry-run --frozen-lockfile --silent && bun run typecheck && oxlint --fix && oxfmt && bun test",
		"typegen": "bun --bun react-router typegen",
		"typecheck": "bun run typegen && tsc",
		"test": "bun test",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@markdoc/markdoc": "^0.5.7",
		"@react-router/dev": "~8.2.0",
		"@react-router/fs-routes": "~8.2.0",
		"@remix-run/form-data-parser": "^0.17.5",
		"@sindresorhus/slugify": "^3.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@visx/xychart": "^3.12.0",
		"better-auth": "^1.7.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-orm": "^1.0.0-rc.4",
		"flexsearch": "^0.8.212",
		"isbot": "^5.1.36",
		"js-yaml": "^5.2.1",
		"motion": "^13.1.1",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8",
		"tailwindcss": "^4.2.2",
		"type-fest": "^5.8.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.3"
	}
}
