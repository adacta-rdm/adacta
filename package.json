{
	"name": "adacta",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"license": "MIT",
	"repository": "git@github.com:omegadot-software/adacta.git",
	"tsrc": {
		"ignore": [
			"lib/tsrc/__tests__"
		]
	},
	"scripts": {
		"users:admin": "bun scripts/cli.ts users:admin",
		"build": "bun scripts/cli.ts build",
		"build:tsrc": "bun lib/tsrc/cli.ts",
		"dev": "bun scripts/cli.ts dev",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"generate": "bun scripts/cli.ts generate",
		"lint": "oxlint",
		"migrations:apply": "bun scripts/cli.ts migrations:apply",
		"migrations:baseline": "bun scripts/cli.ts migrations:baseline",
		"precommit": "bun install --dry-run --frozen-lockfile --silent && bun run typecheck && oxlint --fix && oxfmt && bun run test",
		"seed:load": "bun scripts/cli.ts seed:load",
		"start": "bun scripts/cli.ts start",
		"start:e2e": "bun e2e/server.ts",
		"test": "bun scripts/cli.ts test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "bun run generate && tsc",
		"typegen": "bun --bun react-router typegen"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/language": "^6.11.3",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@markdoc/markdoc": "^0.5.7",
		"@playwright/test": "^1.63.0",
		"@react-router/dev": "~8.2.0",
		"@react-router/fs-routes": "~8.2.0",
		"@remix-run/form-data-parser": "^0.17.5",
		"@sindresorhus/slugify": "^3.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@visx/responsive": "^3.12.0",
		"@visx/xychart": "^3.12.0",
		"@xyflow/react": "^12.11.6",
		"better-auth": "^1.7.2",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-orm": "^1.0.0-rc.4",
		"flexsearch": "^0.8.212",
		"hyparquet": "^1.31.1",
		"hyparquet-writer": "^0.16.10",
		"isbot": "^5.1.36",
		"js-yaml": "^5.2.1",
		"motion": "^13.1.1",
		"nodemailer": "^10.2.1",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8",
		"smol-toml": "^1.9.0",
		"svgo": "^4.1.0",
		"tailwindcss": "^4.2.2",
		"type-fest": "^5.8.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.3"
	}
}
