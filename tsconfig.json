{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"target": "ES2022",

		// ServiceContainer's @Service takes only the constructor, which is the
		// legacy decorator signature. Without this, esbuild passes "@" through
		// untransformed and the dev server fails to parse the module.
		"experimentalDecorators": true,
		"module": "ES2022",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,

		// Bun is the runtime, so no Node types here.
		"types": ["bun", "vite/client"],

		// Paths are relative to the project root, not to app/. Imports read as
		// "~/app/...", "~/lib/...", which keeps every top-level directory
		// addressable the same way.
		"paths": {
			"~/*": ["./*"],
			"~/catalyst-ui/*": ["./vendor/catalyst-ui-kit/typescript/*"]
		},
		"rootDirs": [".", "./.react-router/types"]
	},
	"include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
	// vendor/syntax-ts is the unmodified Tailwind "Syntax" template, kept as a
	// reference for the docs port. It is a Next.js app with its own dependencies,
	// none of which are installed, so tsc must not walk into it. The rest of
	// vendor/ stays included: app code imports it through the "~/catalyst-ui/*"
	// path above.
	"exclude": ["node_modules", "build", "vendor/syntax-ts/**/*"]
}
